# ==============================================================================
# VARIABLES DE ENTORNO — LABORATORIO DE SEGURIDAD
# Copiar este archivo a '.env' si deseas personalizar credenciales o puertos.
#
# AVISO DE SEGURIDAD:
# En este lab usamos contraseñas por defecto sencillas para que puedas levantar
# el entorno local en un solo comando ('docker compose up -d').
# En un despliegue real, NUNCA se commitean contraseñas al repositorio; se inyectan
# en tiempo de ejecución o mediante un gestor de secretos (HashiCorp Vault, AWS Secrets Manager).
# ==============================================================================

DB_HOST=db
DB_PORT=5432
DB_NAME=aseguradora_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_admin_pass

# Credenciales de los roles de aplicación
APP_OVERPRIVILEGED_USER=app_user_overprivileged
APP_OVERPRIVILEGED_PASS=password_vulnerable_123

APP_LEAST_PRIVILEGE_USER=app_user_least_privilege
APP_LEAST_PRIVILEGE_PASS=password_secure_456

PORT=5000
